# Local SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# OpenRouter API key (server-side only). Leave empty to always use the template fallback summary.
OPENROUTER_API_KEY=""

# Any OpenRouter model ID that supports JSON output
AI_MODEL="openai/gpt-4.1-mini"

# Model used to turn voice recordings into text when the browser has no working speech recognition
# (Brave, Firefox). Must accept audio input on OpenRouter.
TRANSCRIBE_MODEL="google/gemini-2.5-flash"

# Demo mode: "true" skips all password screens. Patient pages open as Jane Doe, the EMR opens as the
# oncologist, and Intake Assistant shows one-click role buttons. Set to "false" to require logins.
DISABLE_LOGIN="true"
