generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Staff and patient logins. role: patient | admin | nurse | coop | oncologist
model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  name       String
  role       String
  referralId String?   @unique
  referral   Referral? @relation(fields: [referralId], references: [id])
  createdAt  DateTime  @default(now())
}

model Referral {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  dob              String // YYYY-MM-DD
  sex              String    @default("")
  email            String
  phone            String
  appointmentAt    DateTime
  providerGroup    String
  mrn              String
  // referral_entered | email_sent | in_progress | submitted | help_requested | nurse_completed | coop_pending_review | in_emr
  status           String    @default("referral_entered")
  emailScheduledAt DateTime
  emailSentAt      DateTime?
  createdAt        DateTime  @default(now())

  user         User?
  emails       Email[]
  helpRequests HelpRequest[]
  submissions  IntakeSubmission[]
  documents    EMRDocument[]
  clinicNote   ClinicNote?
}

model Email {
  id         String    @id @default(cuid())
  to         String
  subject    String
  bodyHtml   String
  sentAt     DateTime  @default(now())
  read       Boolean   @default(false)
  referralId String?
  referral   Referral? @relation(fields: [referralId], references: [id])
}

model HelpRequest {
  id         String   @id @default(cuid())
  referralId String?
  referral   Referral? @relation(fields: [referralId], references: [id])
  name       String
  dob        String
  phone      String
  language   String
  bestTime   String
  notes      String   @default("")
  source     String   @default("email") // email | portal | direct
  status     String   @default("new") // new | called | completed
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model IntakeSubmission {
  id                String     @id @default(cuid())
  referralId        String
  referral          Referral   @relation(fields: [referralId], references: [id])
  answers           String     @default("{}") // JSON keyed by field_id
  status            String     @default("draft") // draft | submitted
  completedBy       String     @default("patient") // patient | nurse | coop_student
  completedByUserId String?
  completedByName   String     @default("")
  submittedAt       DateTime?
  incompleteFields  String     @default("[]") // JSON array of field_ids
  // co-op only: pending | approved | returned
  reviewStatus      String?
  reviewComment     String     @default("")
  reviewedByName    String?
  reviewedAt        DateTime?
  updatedAt         DateTime   @updatedAt
  createdAt         DateTime   @default(now())
  summary           AISummary?
  documents         EMRDocument[]
}

model AISummary {
  id           String           @id @default(cuid())
  submissionId String           @unique
  submission   IntakeSubmission @relation(fields: [submissionId], references: [id])
  status       String           @default("pending") // pending | ready
  content      String           @default("{}") // JSON: {paragraph, sections, flagged} with validation flags
  modelUsed    String           @default("")
  isFallback   Boolean          @default(false)
  validation   String           @default("{}") // JSON summary of validation
  generatedAt  DateTime?
  createdAt    DateTime         @default(now())
}

model EMRDocument {
  id             String           @id @default(cuid())
  referralId     String
  referral       Referral         @relation(fields: [referralId], references: [id])
  type           String           @default("Oncology New Patient Intake")
  submissionId   String
  submission     IntakeSubmission @relation(fields: [submissionId], references: [id])
  hasAISummary   Boolean          @default(true)
  verifiedByName String?
  verifiedAt     DateTime?
  createdAt      DateTime         @default(now())
}

model ClinicNote {
  id                  String   @id @default(cuid())
  referralId          String   @unique
  referral            Referral @relation(fields: [referralId], references: [id])
  noteDate            String   @default("")
  oncologist          String   @default("")
  medicalHistory      String   @default("")
  currentMedications  String   @default("")
  allergies           String   @default("")
  socialHistory       String   @default("")
  familyHistory       String   @default("")
  examination         String   @default("")
  plan                String   @default("")
  followUp            String   @default("")
  updatedAt           DateTime @updatedAt
}
